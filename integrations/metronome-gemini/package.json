    "@playwright/mcp": "0.0.80",
    "exceljs": "4.4.0",
    "pg": "8.23.0",
    "pg-connection-string": "2.14.0",
    "pgsql-ast-parser": "12.0.2",
    "zod": "4.6.5"
  },
  "overrides": {
